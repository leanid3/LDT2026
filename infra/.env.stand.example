# Копия -> infra/.env (в .gitignore). Секреты только здесь, не в репозитории.

# Обязательно: секрет подписи JWT. Например: openssl rand -hex 32
AUTH_JWT_SECRET=

# Адрес стенда, как его видит браузер (для presigned-ссылок MinIO): IP или домен машины со стендом.
STAND_HOST=localhost

# Откуда браузеру можно вызывать API (адрес фронтенда), через запятую.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Необязательно: LLM для извлечения (любой OpenAI-совместимый API). Без него — только regex-шаблоны.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Тег образов (git SHA или версия); не используйте latest.
TAG=dev
