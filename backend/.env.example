# Копия для prod-режима: секреты только через ENV, config.yaml в образе не участвует.
LOGGER_LEVEL=info

SERVER_PORT=8080
SERVER_HOST=0.0.0.0
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=5s
SERVER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_DATABASE=inspector
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m

BROKER_BOOTSTRAP_SERVERS=kafka:9092
BROKER_CLIENT_ID=inspector-api
BROKER_PRODUCER_ACKS=-1
BROKER_PRODUCER_IDEMPOTENCE=true
BROKER_PRODUCER_COMPRESSION=snappy
BROKER_PRODUCER_RETRIES=3
BROKER_CONSUMER_SESSION_TIMEOUT_MS=30000
BROKER_CONSUMER_HEARTBEAT_INTERVAL_MS=10000
BROKER_CONSUMER_MAX_POLL_INTERVAL_MS=1800000
BROKER_CONSUMER_FETCH_MAX_BYTES=52428800
BROKER_SECURITY_PROTOCOL=PLAINTEXT
BROKER_SASL_MECHANISM=
BROKER_SASL_USERNAME=
BROKER_SASL_PASSWORD=

METRICS_ENABLED=true
METRICS_PORT=9091
METRICS_PATH=/metrics

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Адрес MinIO для БРАУЗЕРА (presigned-ссылки подписываются под него). Пусто — как MINIO_ENDPOINT.
# В контейнерах MINIO_ENDPOINT=minio:9000, а сюда — опубликованный адрес, например stand.example:9000.
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_USE_SSL=false
MINIO_TIMEOUT=30s

OPENAPI_PATH=../contracts/openapi.yaml

AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL=12h

CLAMAV_ADDRESS=clamav:3310
CLAMAV_TIMEOUT=30s

RIN_ENDPOINT=http://rin-mock:8082
RIN_RETRY_DELAYS=1m,5m,15m
RIN_TIMEOUT=10s
